{
  "manifest_version": 3,
  "name": "YTM AI Artist Detector",
  "version": "0.1.2",
  "description": "Marks AI artists on YouTube Music.",
  "content_scripts": [
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  "icons": {
    "16": "16.png",
    "32": "32.png",
    "48": "48.png",
    "128": "128.png"
  }
}
